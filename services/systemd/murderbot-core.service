[Unit]
Description=Murderbot Service Core - state machine and event routing
# Not installed/enabled automatically - see AGENTS.md rule 3.
After=network.target

[Service]
Type=simple
User=murderbot
# Entrypoint module (murderbot_core.core_service) is implemented and
# unit-tested; this unit is still an example, not installed/enabled
# automatically (AGENTS.md rule 5: safe defaults; phased scope per rule
# 9). Hardware-driving wiring (ATX/audio/RGB) is a separate concern that
# subscribes to the same bus in later phases — see docs/software.md.
ExecStart=/opt/murderbot/services/.venv/bin/python -m murderbot_core.core_service
Restart=on-failure
RestartSec=2
# Owns no direct hardware writes beyond the ATX interface abstraction -
# see docs/architecture.md failure-domain table.

[Install]
WantedBy=multi-user.target
