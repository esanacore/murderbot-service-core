[Unit]
Description=Murderbot Service Core - addressable RGB animations
# Not installed/enabled automatically - see AGENTS.md rule 3.
After=murderbot-core.service
Wants=murderbot-core.service

[Service]
Type=simple
User=murderbot
# Entrypoint module not yet implemented - example for Phase 4 wiring.
ExecStart=/opt/murderbot/services/.venv/bin/python -m murderbot_core.rgb_service
Restart=on-failure
RestartSec=2
# Must default off on configuration or hardware error - never blocks
# murderbot-core or PiKVM (docs/architecture.md failure-domain table).

[Install]
WantedBy=multi-user.target
